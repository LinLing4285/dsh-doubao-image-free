{
    "name": "dsh-doubao-image-free",
    "version": "0.1.0",
    "description": "DeepSeek Harness 插件：把网页版豆包与网页版 ChatGPT 免费账户的生图能力接进 DSH（含图生图、生视频与 Web 设置页）。",
    "type": "module",
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./package.json": "./package.json",
        "./locale/*.json": "./locale/*.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web"
        },
        "compatibility": {
            "dsh": ">=0.2.0-rc.2 <0.3.0",
            "node": ">=20.18",
            "profiles": [
                "web",
                "desktop"
            ]
        }
    },
    "files": [
        "lib",
        "locale",
        "index.js",
        "client.js",
        "client.gallery.js",
        "client.inspiration.js",
        "client.studio.js",
        "client.tldraw.js",
        "cordis.patch.yml",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "dsh",
        "dsh-plugin",
        "deepseek-harness",
        "doubao",
        "image",
        "chatgpt"
    ],
    "license": "MIT",
    "author": "LinLing4285",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LinLing4285/dsh-doubao-image-free.git"
    },
    "homepage": "https://github.com/LinLing4285/dsh-doubao-image-free#readme",
    "bugs": {
        "url": "https://github.com/LinLing4285/dsh-doubao-image-free/issues"
    },
    "engines": {
        "node": ">=20.18"
    },
    "dependencies": {
        "@deepseek-ai/schemastery": "^3.18.4"
    },
    "peerDependencies": {
        "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2 <0.3.0",
        "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0",
        "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
        "react": "^18.2.0"
    }
}
